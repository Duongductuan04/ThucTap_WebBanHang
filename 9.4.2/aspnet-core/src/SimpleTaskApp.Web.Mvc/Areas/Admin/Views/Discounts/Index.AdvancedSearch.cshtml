
<div class="abp-advanced-search mb-3">
  <form id="DiscountsSearchForm" class="form-horizontal">
    <div class="row g-2">

      <!-- Keyword search -->
      <div class="col-md-10">
        <input type="text"
               name="Keyword"
               class="form-control txt-search"
               placeholder="@L("SearchByName")" />
      </div>

      <!-- Search button -->
      <div class="col-md-2">
        <button type="button" class="btn bg-blue btn-search">
          <i class="fas fa-search"></i> @L("Search")
        </button>
      </div>

    </div>
  </form>
</div>
