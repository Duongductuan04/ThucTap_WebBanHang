@model SimpleTaskApp.MobilePhones.Dto.ImportDto
@using System.Globalization

<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Phiếu nhập #@Model.Id</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <style>
    body {
      font-family: Arial, sans-serif;
    }

    .invoice-header {
      border-bottom: 2px solid #333;
      margin-bottom: 10px;
      padding-bottom: 10px;
    }

    .invoice-title {
      text-align: center;
      font-size: 1.2rem;
      font-weight: bold;
      margin: 10px 0 20px 0;
    }

    .invoice-footer {
      border-top: 2px solid #333;
      margin-top: 20px;
      font-size: 0.9rem;
      text-align: center;
    }

    .table th, .table td {
      vertical-align: middle;
    }
  </style>
</head>
<body>
  <div class="container my-4">
    <!-- Header: Logo + Shop info -->
    <div class="d-flex justify-content-between align-items-center invoice-header">
      <div>
        <img src="~/img/08Oct_Anis__Free_Upload_bbbb-removebg-preview.png" alt="Shop Logo" style="height:80px;">
      </div>
      <div class="text-end">
        <h3 class="mb-0 fw-bold">Tuấn Tech</h3>
        <p class="mb-0">Hotline: 0797183943</p>
        <p class="mb-0">Email: duongductuan361@gmail.com</p>
        <p class="mb-0">Địa chỉ: 105 Phố Trần Hòa, Định Công, Hoàng Mai, Hà Nội</p>
      </div>
    </div>

    <!-- Mã phiếu nhập -->
    <div class="invoice-title">
      PHIẾU NHẬP: #@Model.Id
    </div>

    <!-- Thông tin phiếu nhập -->
    <div class="row mb-4">
      <div class="col-md-6">
        <p><strong>Mã phiếu:</strong> @Model.ImportCode</p>
        <p><strong>Nhà cung cấp:</strong> @Model.SupplierName</p>
      </div>
      <div class="col-md-6">
        <p><strong>Người nhập:</strong> @Model.KeeperName</p>
        <p><strong>Số điện thoại:</strong> @Model.KeeperPhone</p>
        <p><strong>Ngày nhập:</strong> @Model.CreationTime.ToString("dd/MM/yyyy HH:mm")</p>
      </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Note))
    {
      <div class="mb-3">
        <p><strong>Ghi chú:</strong> @Model.Note</p>
      </div>
    }

    <!-- Bảng chi tiết sản phẩm -->
    <table class="table table-bordered table-striped">
      <thead class="table-light">
        <tr>
          <th>Sản phẩm</th>
          <th>Màu</th>
          <th>Số lượng</th>
          <th>Đơn giá</th>
          <th>Thành tiền</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var detail in Model.ImportDetails)
        {
          <tr>
            <td>@detail.MobilePhoneName</td>
            <td>@(string.IsNullOrEmpty(detail.MobilePhoneColorName) ? "-" : detail.MobilePhoneColorName)</td>
            <td>@detail.Quantity</td>
            <td>@detail.ImportPrice.ToString("C0", CultureInfo.GetCultureInfo("vi-VN"))</td>
            <td>@((detail.ImportPrice * detail.Quantity).ToString("C0", CultureInfo.GetCultureInfo("vi-VN")))</td>
          </tr>
        }
      </tbody>
    </table>

    <!-- Tổng tiền (tính trực tiếp) -->
    @{
      var totalAmount = Model.ImportDetails?.Sum(d => d.ImportPrice * d.Quantity) ?? 0;
    }
    <div class="d-flex flex-column align-items-end mt-3">
      <h5 class="fw-bold"><strong>Tổng tiền:</strong> @totalAmount.ToString("C0", CultureInfo.GetCultureInfo("vi-VN"))</h5>
    </div>

    <!-- Footer -->
    <div class="invoice-footer mt-4">
      <p>Cảm ơn bạn đã nhập hàng tại Tuấn Tech!</p>
      <button class="btn btn-primary mt-3 no-print" onclick="window.print();">In phiếu nhập</button>
    </div>
  </div>
</body>
</html>
