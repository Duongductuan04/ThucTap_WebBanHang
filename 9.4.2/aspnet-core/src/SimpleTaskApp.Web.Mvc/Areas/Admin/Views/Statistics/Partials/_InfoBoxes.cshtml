@model SimpleTaskApp.Statistics.Dto.StatisticsDto


<div class="overview-wrapper p-4 rounded-4 border shadow-sm bg-white">
  <!-- Header -->
  <div class="overview-header mb-4 d-flex justify-content-between align-items-center">
    <!-- Tiêu đề -->
    <div class="d-flex flex-column justify-content-center">
      <h2 class="fw-bold text-primary mb-1" style="line-height:1.2;">
        📊 Báo cáo tổng quan
        @if (Model.Filter != null)
        {
          var start = DateTime.Parse(Model.Filter.StartDate).ToString("dd/MM/yyyy");
          var end = DateTime.Parse(Model.Filter.EndDate).ToString("dd/MM/yyyy");

          if (start == end)
          {
            <small class="text-primary d-block" style="font-size:0.85em;">(@start)</small>
          }
          else
          {
            <small class="text-primary d-block" style="font-size:0.85em;">(Từ @start đến @end)</small>
          }
        }
      </h2>
    </div>

    <!-- Nút Excel -->
    <div class="d-flex align-items-center">
      <a class="btn btn-success d-flex align-items-center shadow-sm"
         style="height:48px; padding:0 18px; font-weight:500; border-radius:8px;"
         href="@Url.Action("ExportExcel", "Statistics", new {
                    startDate = Model.Filter?.StartDate,
                    endDate = Model.Filter?.EndDate
               })">
        <i class="fas fa-file-excel me-2"></i> Xuất Excel
      </a>
    </div>
  </div>

  <div class="row g-4">
    <!-- Sản phẩm đã bán -->
    <div class="col-md-3 col-sm-6">
      <div class="card rounded-4 shadow-sm border border-light text-center py-4 bg-white hover-scale">
        <div class="card-body">
          <div class="icon-wrapper bg-info-light rounded-circle mb-3">
            <i class="fas fa-box-open fa-2x text-info"></i>
          </div>
          <h6 class="fw-semibold text-muted">Sản phẩm đã bán</h6>
          <h3 class="fw-bold text-dark counter" data-count="@Model.TotalProductsSold">0</h3>
        </div>
      </div>
    </div>

    <!-- Đơn hàng -->
    <div class="col-md-3 col-sm-6">
      <div class="card rounded-4 shadow-sm border border-light text-center py-4 bg-white hover-scale">
        <div class="card-body">
          <div class="icon-wrapper bg-success-light rounded-circle mb-3">
            <i class="fas fa-shopping-cart fa-2x text-success"></i>
          </div>
          <h6 class="fw-semibold text-muted">Đơn hàng</h6>
          <h3 class="fw-bold text-dark counter" data-count="@Model.TotalOrders">0</h3>
        </div>
      </div>
    </div>

    <!-- Khách hàng -->
    <div class="col-md-3 col-sm-6">
      <div class="card rounded-4 shadow-sm border border-light text-center py-4 bg-white hover-scale">
        <div class="card-body">
          <div class="icon-wrapper bg-warning-light rounded-circle mb-3">
            <i class="fas fa-users fa-2x text-warning"></i>
          </div>
          <h6 class="fw-semibold text-muted">Khách hàng</h6>
          <h3 class="fw-bold text-dark counter" data-count="@Model.TotalCustomers">0</h3>
        </div>
      </div>
    </div>

    <!-- Doanh thu -->
    <div class="col-md-3 col-sm-6">
      <div class="card rounded-4 shadow-sm border border-light text-center py-4 bg-white hover-scale">
        <div class="card-body">
          <div class="icon-wrapper bg-danger-light rounded-circle mb-3">
            <i class="fas fa-dollar-sign fa-2x text-danger"></i>
          </div>
          <h6 class="fw-semibold text-muted">Doanh thu</h6>
          <h3 class="fw-bold text-dark counter" data-count="@Model.MonthlyRevenue">0</h3>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="row mt-4">
  <div class="col-12">
    <div class="card rounded-4 shadow-sm p-3">
      <h6 class="fw-semibold mb-3">
        <i class="fas fa-chart-bar me-2"></i>Doanh thu theo thời gian
        @if (Model.Filter != null)
        {
          <small class="text-muted">
            (@(string.IsNullOrEmpty(Model.Filter.StartDate) ? "--" : Model.Filter.StartDate.Substring(0, 10))
            - @(string.IsNullOrEmpty(Model.Filter.EndDate) ? "--" : Model.Filter.EndDate.Substring(0, 10)))
          </small>
        }
      </h6>
      <div class="chart-container" style="position: relative; height:400px; width:100%;">
        <canvas id="overviewRevenueChart"></canvas>
      </div>
    </div>
  </div>
</div>
<style>
  .overview-wrapper {
    border: 1px solid #dee2e6;
  }

  .hover-scale:hover {
    transform: translateY(-5px);
    transition: all 0.3s ease;
  }

  .icon-wrapper {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bg-info-light {
    background-color: #e0f3ff;
  }

  .bg-success-light {
    background-color: #e6f9f0;
  }

  .bg-warning-light {
    background-color: #fff7e6;
  }

  .bg-danger-light {
    background-color: #ffe6e6;
  }
</style>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  // Animation đếm số liệu với "đ" phía sau
  document.querySelectorAll('.counter').forEach(el => {
      const count = parseInt(el.dataset.count);
      let current = 0;
      const step = Math.ceil(count / 100);
      const interval = setInterval(() => {
          current += step;
          if(current >= count) {
              el.innerText = count.toLocaleString('vi-VN') + ' đ';
              clearInterval(interval);
          } else {
              el.innerText = current.toLocaleString('vi-VN') + ' đ';
          }
      }, 15);
  });

    var ctx = document.getElementById('overviewRevenueChart').getContext('2d');

  // Lấy dữ liệu từ model
  var labelsChart = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.RevenueChartLabels));
  var dataChart = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.RevenueChartData));

  // Hàm tạo màu ngẫu nhiên cho từng cột
  function getRandomColor() {
      const r = Math.floor(Math.random() * 156) + 100;
      const g = Math.floor(Math.random() * 156) + 100;
      const b = Math.floor(Math.random() * 156) + 100;
      return `rgba(${r},${g},${b},0.7)`;
  }
  var backgroundColors = dataChart.map(() => getRandomColor());

  // Tính giá trị max và stepSize "đẹp"
  var maxValue = Math.max(...dataChart);
  function niceStep(max) {
      const magnitude = Math.pow(10, Math.floor(Math.log10(max)));
      const step = magnitude / 5; // chia làm 5 tick
      return Math.ceil(max / (step * 5)) * step;
  }
  var stepSize = niceStep(maxValue);
  var suggestedMax = stepSize * 5;

  // Tạo Chart
  var overviewChart = new Chart(ctx, {
      type: 'bar',
      data: {
          labels: labelsChart,
          datasets: [{
              label: 'Doanh thu',
              data: dataChart,
              backgroundColor: backgroundColors,
              borderColor: backgroundColors.map(c => c.replace('0.7', '1')),
              borderWidth: 1,
              borderRadius: 6,
              barPercentage: 0.5,
              categoryPercentage: 0.6
          }]
      },
      options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
              legend: { display: false },
              tooltip: {
                  callbacks: {
                      label: function(context) {
                          return context.dataset.label + ': ' + context.raw.toLocaleString('vi-VN') + ' đ';
                      }
                  }
              }
          },
          scales: {
              y: {
                  beginAtZero: true,
                  max: suggestedMax,
                  ticks: {
                      stepSize: stepSize,
                      callback: function(value) {
                          return value.toLocaleString('vi-VN') + ' đ';
                      }
                  }
              },
              x: {
                  grid: { display: false },
                  ticks: {
                      maxRotation: 45,
                      minRotation: 0,
                      autoSkip: true
                  }
              }
          }
      }
  });

</script>
