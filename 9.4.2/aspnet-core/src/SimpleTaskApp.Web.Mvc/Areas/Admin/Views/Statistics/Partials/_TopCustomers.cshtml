@model List<SimpleTaskApp.Statistics.Dto.TopCustomerDto>

<div class="card shadow">
  <div class="card-body">
    <h5 class="card-title">🏅 Top khách hàng</h5>
    <table class="table table-bordered text-center">
      <thead class="table-dark">
        <tr><th>#</th><th>Tên</th><th>Đơn hàng</th><th>Chi tiêu</th></tr>
      </thead>
      <tbody>
        @for (int i = 0; i < Model.Count; i++)
        {
          <tr>
            <td>@(i + 1)</td>
            <td>@Model[i].UserName</td>
            <td>@Model[i].TotalOrders</td>
            <td>@Model[i].TotalSpent.ToString("N0") đ</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
