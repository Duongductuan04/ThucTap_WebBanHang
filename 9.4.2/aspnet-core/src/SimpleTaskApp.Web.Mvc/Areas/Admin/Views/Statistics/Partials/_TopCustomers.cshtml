@model SimpleTaskApp.Web.Areas.Admin.Models.Statistics.TopCustomersViewModel

@if (Model?.TopCustomers == null || !Model.TopCustomers.Any())
{
  <div class="alert alert-warning text-center my-3">
    Không có khách hàng tiêu biểu nào
  </div>
}
else
{
  <div class="card shadow rounded-4 border-0 my-3">
    <div class="card-body">
      <!-- Header + nút Excel -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-danger fw-bold mb-0">
          <i class="fas fa-star me-2"></i>Top khách hàng tiềm năng
        </h3>

        <a class="btn btn-success d-flex align-items-center shadow-sm"
           style="height:48px; padding:0 18px; font-weight:500; border-radius:8px; text-decoration:none;"
           href="@Url.Action("ExportTopCustomersExcel", "Statistics", new { startDate = Model.Filter?.StartDate, endDate = Model.Filter?.EndDate })">
          <i class="fas fa-file-excel me-2"></i> Xuất Excel
        </a>
      </div>

      <!-- Bảng danh sách -->
      <div class="table-responsive">
        <table class="table table-hover align-middle text-center mb-0">
          <thead class="table-gradient text-white">
            <tr>
              <th scope="col">STT</th>
              <th scope="col" class="text-start">Họ & Tên</th>
              <th scope="col">SĐT</th>
              <th scope="col" class="text-start">Địa chỉ</th>
              <th scope="col">Đơn hàng</th>
              <th scope="col">Tổng SP</th>
              <th scope="col">Chi tiêu</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var (customer, index) in Model.TopCustomers.Select((c, i) => (c, i)))
            {
              <tr>
                <td class="fw-bold">@(@index + 1)</td>
                <td class="text-start">@customer.UserName</td>
                <td>@customer.PhoneNumber</td>
                <td class="text-start">@customer.Address</td>
                <td class="fw-semibold">@customer.TotalOrders</td>
                <td class="fw-semibold">@customer.TotalProducts</td>
                <td class="fw-bold text-success">@customer.TotalSpent.ToString("N0") đ</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <style>
    .table-gradient {
      background: linear-gradient(90deg, #4e73df, #1cc88a);
    }

    .table-hover tbody tr:hover {
      background-color: rgba(0, 0, 0, 0.05);
    }
  </style>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
}
