@model List<SimpleTaskApp.Statistics.Dto.TopCustomerDto>

<div class="card shadow rounded-4 border-0">
  <div class="card-body">
    <h5 class="card-title mb-4 d-flex align-items-center">
      <i class="fas fa-user-tie me-2 text-primary"></i>
      Top Khách Hàng
    </h5>

    <div class="table-responsive">
      <table class="table table-hover align-middle text-center mb-0">
        <thead class="table-gradient text-white">
          <tr>
            <th scope="col">STT</th>
            <th scope="col" class="text-start">Họ & Tên</th>
            <th scope="col">SĐT</th>
            <th scope="col" class="text-start">Địa chỉ</th>
            <th scope="col">Đơn hàng</th>
            <th scope="col">Tổng SP</th>
            <th scope="col">Chi tiêu</th>
          </tr>
        </thead>
        <tbody>
          @for (int i = 0; i < Model.Count; i++)
          {
            <tr class="align-middle">
              <td class="fw-bold">@(@i + 1)</td>
              <td class="text-start">@Model[i].UserName</td>
              <td>@Model[i].PhoneNumber</td>
              <td class="text-start">@Model[i].Address</td>
              <td class="fw-semibold">@Model[i].TotalOrders</td>
              <td class="fw-semibold">@Model[i].TotalProducts</td>
              <td class="fw-bold text-success">@Model[i].TotalSpent.ToString("N0") đ</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  .table-gradient {
    background: linear-gradient(90deg, #4e73df, #1cc88a);
  }

  .table-hover tbody tr:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }
</style>

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
