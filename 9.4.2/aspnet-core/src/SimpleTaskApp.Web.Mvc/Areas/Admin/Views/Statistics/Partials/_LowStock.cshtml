@model List<SimpleTaskApp.Statistics.Dto.LowStockProductVariantDto>

<div class="card shadow rounded-4">
  <div class="card-body">
    <h5 class="card-title mb-4"><i class="fas fa-boxes me-2"></i>Sản phẩm tồn kho thấp</h5>

    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle text-center">
        <thead class="table-danger">
          <tr>
            <th scope="col">#</th>
            <th scope="col">Ảnh</th>
            <th scope="col">Sản phẩm</th>
            <th scope="col">Màu sắc</th>
            <th scope="col">Tồn kho màu</th>
            <th scope="col">Tổng tồn kho</th>
            <th scope="col">Ngày nhập cuối</th>
          </tr>
        </thead>
        <tbody>
          @for (int i = 0; i < Model.Count; i++)
          {
            var item = Model[i];
            <tr>
              <td>@(i + 1)</td>
              <td>
                <img src="@item.ImageUrl" alt="@item.ProductName"
                     style="width:50px;height:50px;object-fit:cover;border-radius:4px;" />
              </td>
              <td class="text-start">@item.ProductName</td>
              <td>@item.Color</td>
              <td>@item.ColorStockQuantity</td>
              <td>@item.TotalStockQuantity</td>
              <td>
                @(item.LastImportDate.HasValue
                    ? item.LastImportDate.Value.ToString("dd/MM/yyyy")
                    : "-")
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
