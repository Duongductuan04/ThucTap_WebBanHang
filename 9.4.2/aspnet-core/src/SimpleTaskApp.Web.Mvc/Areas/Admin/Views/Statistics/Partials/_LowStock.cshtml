@model List<SimpleTaskApp.Statistics.Dto.LowStockProductVariantDto>

@if (Model == null || !Model.Any())
{
  <div class="alert alert-warning text-center my-3">
    Không có sản phẩm tồn kho thấp
  </div>
}
else
{
  <div class="card shadow rounded-4 my-3">
    <div class="card-body">
      <!-- Header + nút Excel -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class=" mb-0">
          <i class="fas fa-boxes me-2"></i>Sản phẩm tồn kho thấp
        </h3>

        <a href="/Admin/Statistics/ExportLowStockProductsExcel" class="btn btn-success">
          <i class="fas fa-file-excel me-1"></i> Xuất Excel
        </a>
      </div>

      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle text-center">
          <thead class="table-danger">
            <tr>
              <th>#</th>
              <th>Ảnh</th>
              <th class="text-start">Sản phẩm</th>
              <th>Màu sắc</th>
              <th>Tồn kho màu</th>
              <th>Tổng tồn kho</th>
              <th>Ngày nhập cuối</th>
            </tr>
          </thead>
          <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
              var item = Model[i];
              <tr>
                <td>@(i + 1)</td>
                <td>
                  <img src="@item.ImageUrl" alt="@item.ProductName"
                       class="img-thumbnail" style="width:50px;height:50px;object-fit:cover;" />
                </td>
                <td class="text-start">@item.ProductName</td>
                <td>@item.Color</td>
                <td>
                  @(item.Color != null ? item.ColorStockQuantity.ToString() : "")
                </td>
                <td>@item.TotalStockQuantity</td>
                <td>
                  @(item.LastImportDate.HasValue
                      ? item.LastImportDate.Value.ToString("dd/MM/yyyy")
                      : "-")
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
}
