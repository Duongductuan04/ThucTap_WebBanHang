@model SimpleTaskApp.Statistics.Dto.StatisticsDto
@{
  ViewBag.Title = "Thống kê";
}

<div class="container mt-4">
  <h2 class="mb-4">📈 Dashboard Thống kê Doanh thu & Sản phẩm</h2>

  <div class="row">
    <!-- Bộ lọc -->
    <div class="col-lg-3 mb-3">
      <div class="card shadow p-3">
        <h5 class="fw-bold mb-3">Bộ lọc thống kê</h5>
        <form id="filterForm">
          <div class="mb-3">
            <label for="StartEndRange" class="form-label">Chọn khoảng thời gian</label>
            <input id="StartEndRange" type="text" class="form-control date-range-picker" placeholder="Từ ngày - đến ngày" />
          </div>
          <div class="mb-3">
            <label for="statisticSelect" class="form-label">Chọn loại thống kê</label>
            <select id="statisticSelect" class="form-select">
              <option value="Overview" selected>📊 Báo cáo tổng quan</option>
              <option value="TopProducts">🔥 Top sản phẩm</option>
              <option value="BrandRevenue">🏷 Doanh thu theo thương hiệu</option>
              <option value="LowStock">⚠ Tồn kho thấp</option>
              <option value="TopCustomers">👑 Khách hàng tiềm năng</option>
            </select>
          </div>
          <button type="button" id="btnLoadStatistics" class="btn btn-secondary w-100">Thống kê</button>
        </form>
      </div>
    </div>

    <!-- Nội dung chính -->
    <div class="col-lg-9">
    

      <!-- Khu vực load partial -->
      <div id="statisticContainer" class="mt-4"></div>
    </div>
  </div>
</div>

@section scripts {
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/moment/min/moment.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
  <script src="~/view-resources/Views/Statistics/statistics-pie.js"></script>
  <script src="~/view-resources/Views/Statistics/Index.js"></script>

}