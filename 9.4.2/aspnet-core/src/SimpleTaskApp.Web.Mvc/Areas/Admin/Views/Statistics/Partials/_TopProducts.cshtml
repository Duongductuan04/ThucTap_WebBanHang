@model List<SimpleTaskApp.Statistics.Dto.TopProductDto>

<div class="card shadow">
  <div class="card-body">
    <h5 class="card-title">🏆 Top sản phẩm bán chạy</h5>
    <table class="table table-bordered text-center">
      <thead class="table-dark">
        <tr><th>#</th><th>Sản phẩm</th><th>Số lượng</th></tr>
      </thead>
      <tbody>
        @for (int i = 0; i < Model.Count; i++)
        {
          <tr>
            <td>@(i + 1)</td>
            <td>@Model[i].ProductName</td>
            <td>@Model[i].QuantitySold</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
