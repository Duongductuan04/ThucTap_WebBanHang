@model SimpleTaskApp.Web.Areas.Admin.Models.Statistics.CategoryRevenueViewModel

@if (Model?.Categories == null || !Model.Categories.Any())
{
  <div class="alert alert-warning text-center my-3">
    Không có dữ liệu thống kê theo danh mục
  </div>
}
else
{
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold text-secondary mb-0">
      <i class="fas fa-chart-pie me-2"></i>Doanh thu theo danh mục & thương hiệu
    </h3>

    <!-- Nút Xuất Excel -->
    <a class="btn btn-success d-flex align-items-center shadow-sm"
       style="height:48px; padding:0 18px; font-weight:500; border-radius:8px; text-decoration:none;"
       href="@Url.Action("ExportCategoryRevenueExcel", "Statistics", new { startDate = Model.Filter?.StartDate, endDate = Model.Filter?.EndDate })">
      <i class="fas fa-file-excel me-2"></i> Xuất Excel
    </a>
  </div>

  @foreach (var cat in Model.Categories)
  {
    <div class="card shadow-sm mt-4 rounded-4">
      <div class="card-header bg-secondary text-white text-center">
        <h5 class="mb-0">@cat.CategoryName</h5>
      </div>
      <div class="card-body">
        @if (cat.BrandRevenues != null && cat.BrandRevenues.Any())
        {
          <div class="row align-items-center">
            <!-- Chart -->
            <div class="col-lg-5 col-md-12 text-center mb-3 mb-lg-0">
              <canvas class="pie-chart"
                      data-brands='@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(cat.BrandRevenues))'
                      style="width:100%; max-width:400px; height:400px;">
              </canvas>
            </div>

            <!-- Chi tiết doanh thu từng brand -->
            <div class="col-lg-6 col-md-12 mx-auto">
              <ul class="list-group">
                @foreach (var b in cat.BrandRevenues.OrderByDescending(x => x.Revenue))
                {
                  <li class="list-group-item d-flex justify-content-between align-items-center mb-2 p-3 shadow-sm rounded-3 brand-item"
                      style="background-color:#ffffff;">
                    <span class="fw-semibold">@b.BrandName</span>
                    <span class="badge rounded-pill px-3 py-1"
                          style="background: linear-gradient(90deg, #4caf50, #81c784); color:white;">
                      @b.Revenue.ToString("N0") đ
                    </span>
                  </li>
                }
              </ul>
            </div>
          </div>
        }
        else
        {
          <p class="text-center text-muted fst-italic mb-0">Không có dữ liệu</p>
        }
      </div>
    </div>
  }
}

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
