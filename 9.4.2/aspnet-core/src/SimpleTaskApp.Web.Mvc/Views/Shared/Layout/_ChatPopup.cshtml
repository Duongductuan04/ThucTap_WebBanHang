@using SimpleTaskApp.Authorization.Users
@inject UserManager UserManager

<!-- Icon chat -->
<div id="chatIcon">💬</div>

<!-- Chat popup -->
<div id="chatPopup">
  <div id="chatHeader">
    <div><span>💬</span> Chat với Admin</div>
    <div id="closeChat">✖</div>
  </div>
  <div id="chatBody"></div>
  <div id="chatInputArea">
    <textarea id="chatInput" placeholder="Nhập tin nhắn của bạn..."></textarea>
    <button id="sendBtn">➤</button>
  </div>
</div>


<!-- Lấy userId từ server -->

<script>
  const userId = @(UserManager.AbpSession.UserId.HasValue ? UserManager.AbpSession.UserId.Value.ToString() : "0");
  console.log("UserId:", userId);
</script>

<!-- SignalR + JS chat -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
<script src="~/view-resources/Views/Chats/chat.js" asp-append-version="true"></script>